/*
 * nextflow.config
 * Default resource limits are tuned for the project's 2 GB WSL memory budget
 * (see .wslconfig: memory=2GB, swap=16GB). Every process caps at <=1.5GB RAM
 * and 1 CPU so nothing forces the whole VM into swap simultaneously.
 */

manifest {
    name        = 'gut-pangenome'
    description = 'Three-Day Gut Bacterial Pangenome Project (subset reanalysis of Zou et al. 2019)'
    version     = '0.1.0'
}

params {
    samplesheet    = "${projectDir}/data/metadata/samplesheet.tsv"
    genome_dir     = "${projectDir}/data/genomes"
    outdir         = "${projectDir}/results"
    figures_dir    = "${projectDir}/figures"
    core_threshold = 0.98
    python_bin     = "python3"
}

process {
    cpus   = 1
    memory = '1 GB'
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2
}

executor {
    // Single-node WSL box: cap parallel processes so total memory
    // never exceeds the 2GB physical limit even with several genomes
    // annotating "in parallel".
    cpus   = 2
    memory = '2 GB'
    queueSize = 2
}

profiles {

    // Fast smoke-test: only 2-3 genomes, used to confirm the pipeline
    // runs end-to-end before committing to the full subset.
    test {
        includeConfig 'conf/test.config'
    }

    // Full 10-20 genome local run on the WSL workstation.
    local {
        includeConfig 'conf/local.config'
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled = true
    }
}

// Basic execution reports - handy for a "professional" reproducible project
timeline {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
