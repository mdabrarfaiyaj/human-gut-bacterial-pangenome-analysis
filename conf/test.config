/*
 * conf/test.config
 * Smoke-test profile: 2-3 genomes only, should finish in a few minutes
 * even on the 2GB WSL box. Run this BEFORE the full 'local' profile.
 */

params {
    samplesheet = "${projectDir}/data/metadata/samplesheet_test.tsv"
}

process {
    cpus   = 1
    memory = '512 MB'
    time   = '1h'
}

executor {
    queueSize = 1
}
